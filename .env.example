# 复制为 .env 后填写。.env 已在 .gitignore 里，不要提交到任何仓库。

# 端口（宿主机映射端口；容器内固定 9778，两边默认一致）
PORT=9778

# 访问口令。**留空 = 关掉这层鉴权**，页面不再要求输入口令，
# 安全性完全依赖前置反代（Lucky/Nginx）上的那层验证。填上值就重新开启，
# 改完重启容器即生效，两种状态随时切。
#
# 长度下限 MIN_TOKEN_LENGTH（默认 6 字符），低于下限拒绝启动。
# 前面有反代兜底时 6~12 位够用；若把端口直接暴露到公网，请用下面这条
# 命令生成的 32 位随机串：
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
WEB_TOKEN=

# 容器以哪个 uid/gid 运行。必须与挂载进去的 ./data 目录属主一致，
# 否则写不进登录凭据，症状是"扫码成功但重启后又变回未登录"
# （启动日志会直接报"数据目录不可写"，不用猜）。
#
# 两种做法任选一种：
#   A. 宿主机上执行 chown -R 10001:10001 ./data —— 下面两行保持 10001 不动
#   B. 不动宿主机文件：ls -nd ./data 看第一列的 uid/gid 数字，填到这里
#
# 容器全程非 root，不会去改你宿主机的文件属主。
PUID=10001
PGID=10001

# ---------- 构建相关 ----------
# 构建时用的 PyPI 源。国内 NAS 建议换成阿里云：
#   PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# 注意：清华源缺 mijiaAPI 包，会导致构建失败
PIP_INDEX_URL=https://pypi.org/simple

# 基础镜像地址。国内直连 Docker Hub 拉不动（build 会卡在
# "load metadata for docker.io/library/python"），NAS 自带的加速器又可能
# 需要账号登录——飞牛的 docker.fnnas.com 就属于这种：返回 401 却不给
# WWW-Authenticate，Docker 无法走认证流程，直接报
#   failed to resolve source metadata for docker.io/library/python:3.12-slim
# 默认走 DaoCloud 公共源，实测可用。备选：docker.1ms.run
# 只想拉一次、不想每次都依赖公共源的话，可以先手动拉下来再改回官方名：
#   docker pull docker.m.daocloud.io/library/python:3.12-slim
#   docker tag  docker.m.daocloud.io/library/python:3.12-slim python:3.12-slim
#   # 然后把下面这行改成 PYTHON_BASE=python:3.12-slim
PYTHON_BASE=docker.m.daocloud.io/library/python:3.12-slim

# Debian apt 源。构建时只装一个 tzdata，但不换源会卡在 deb.debian.org。
# 留空则使用官方源（境外机器适用）。
DEBIAN_MIRROR=mirrors.aliyun.com

# ---------- 反代相关，一般不用改 ----------
# 容器只监听 HTTP，证书和 HTTPS 全部交给前面的反代（Lucky / Nginx / Caddy）。
#
# TRUST_PROXY=1：从 X-Forwarded-For 取真实客户端 IP。
#   反代后面必须开，否则所有人的来源 IP 都是反代地址，一次输错口令
#   就把所有人一起锁 30 分钟。只有在没有反代、纯内网直连时才设 0。
TRUST_PROXY=1
#
# FORCE_HTTPS=0：容器不会因为"看到明文"就拒绝请求。
#   反代漏配 TLS 时宁可先跑通，也不要在中间多加一层挡人的逻辑。
#   想加这层兜底再设 1——前提是反代确实传了 X-Forwarded-Proto: https。
FORCE_HTTPS=0
#
# HSTS_MAX_AGE=0：容器不发 HSTS，交给反代发。
#   HSTS 是不可撤销的，容器看不见上游证书能撑多久，误发会让整个域名
#   一年内只能走 https。要容器发就填秒数，例如 31536000。
HSTS_MAX_AGE=0

# 以下仅公网部署（docker-compose.prod.yml）需要
# 公网域名，需解析到运行本服务的机器
DOMAIN=mihome.example.com
